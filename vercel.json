{
  "rewrites": [
    {
      "source": "/products/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(TelegramBot|facebookexternalhit|Facebot|Twitterbot|WhatsApp|Slackbot|LinkedInBot|Discordbot|vkShare|Viber|SkypeUriPreview|Pinterest|redditbot|Iframely|Embedly).*"
        }
      ],
      "destination": "/api/preview?id=:id"
    },
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(TelegramBot|facebookexternalhit|Facebot|Twitterbot|WhatsApp|Slackbot|LinkedInBot|Discordbot|vkShare|Viber|SkypeUriPreview|Pinterest|redditbot|Iframely|Embedly).*"
        }
      ],
      "destination": "/api/preview"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
